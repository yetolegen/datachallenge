# Copy to .env and fill in. .env is gitignored — never commit keys or the signed API link.

# Organizers' GET link (from the "Открыть GET для DEV" button) with group_id replaced by {group_id}
CQA_API_URL_TEMPLATE=https://<...>/invoke?api-version=1&sp=...&sv=1.0&sig=<...>&group_id={group_id}

# LLM: ollama (local) | openai (any OpenAI-compatible API) | fake (tests, no model)
# These are defaults; the Settings page in the UI can change them at runtime.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=12288
# true/false for thinking models like qwen3; leave empty for models without thinking
OLLAMA_THINK=false
# Kazakh (KZ) dialogs use their own model + provider (see docs/SETUP_4060.md, "Sherkala").
# Empty LLM_MODEL_KZ = KZ dialogs use LLM_MODEL.
LLM_MODEL_KZ=sherkala
LLM_PROVIDER_KZ=ollama
# Leave empty for models without a thinking mode (Sherkala / Llama-based)
OLLAMA_THINK_KZ=
LLM_CONCURRENCY=1
LLM_TIMEOUT_S=300

# Cloud option: any OpenAI-compatible API. Set LLM_PROVIDER=openai (or switch in Настройки) to use it.
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/   (key: aistudio.google.com)
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
# OPENAI_API_KEY is the key for whichever service OPENAI_BASE_URL points to.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=

EXPLANATION_LANG=ru
# Comma-separated origins allowed to call the API (e.g. a future Dynamics 365 org)
CORS_ORIGINS=
