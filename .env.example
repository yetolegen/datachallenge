# Copy to .env and fill in. .env is gitignored — never commit keys or the signed API link.

# Organizers' GET link (from the "Открыть GET для DEV" button) with group_id replaced by {group_id}
CQA_API_URL_TEMPLATE=https://<...>/invoke?api-version=1&sp=...&sv=1.0&sig=<...>&group_id={group_id}

# LLM: ollama (local) | openai (any OpenAI-compatible API) | fake (tests, no model)
# These are defaults; the Settings page in the UI can change them at runtime.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_CTX=12288
# true/false for thinking models like qwen3; leave empty for models without thinking
OLLAMA_THINK=false
LLM_CONCURRENCY=1
LLM_TIMEOUT_S=300

# Optional cloud backup (OpenAI, Gemini OpenAI-compatible endpoint, OpenRouter...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

EXPLANATION_LANG=ru
# Comma-separated origins allowed to call the API (e.g. a future Dynamics 365 org)
CORS_ORIGINS=
